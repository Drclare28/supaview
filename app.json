{
  "expo": {
    "name": "SupaView",
    "slug": "SupabaseClient",
    "scheme": "supaview",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/SupaView_Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#09111c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drclare28.SupabaseClient"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#09111c"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ]
  }
}
